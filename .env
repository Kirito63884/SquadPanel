# ---------- SquadPanel ----------
# Скопируйте в .env и заполните при необходимости. Файл .env НЕ коммитится.
# Всё необязательно: без .env панель стартует на встроенной базе, а ключ создаст сама.

# Главный секрет (>= 32 символов): из него выводятся ключ шифрования RCON-паролей
# (AES-256-GCM), ключ сессий и токен между web и воркером.
# Если не задан — генерируется в <SQUADPANEL_DATA_DIR>/secret.key (сделайте резервную копию!).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SQUADPANEL_SECRET=

# База данных. Пусто = встроенная PGlite в <SQUADPANEL_DATA_DIR>/pglite (одна машина, без установки).
# DATABASE_URL=postgres://squadpanel:change-me@localhost:5432/squadpanel

# Папка данных (база PGlite, secret.key, данные плагинов)
SQUADPANEL_DATA_DIR=data
SQUADPANEL_LANG=ru
SQUADPANEL_POLL_MS=5000
LOG_LEVEL=info

# ----- Импорт при первом запуске (мастер настройки) -----
# Серверы из этих источников предлагаются к импорту один раз; дальше всё хранится в базе
# и редактируется в панели. Импортированный сервер по умолчанию в режиме "только чтение".
# SQUAD_RCON_HOST=
# SQUAD_RCON_PORT=21114
# SQUAD_RCON_PASSWORD=
# SQUAD_SERVER_NAME=Мой сервер
# SQUAD_RCON_READONLY=true
# SQUADPANEL_CONFIG=config/servers.json
# Предложить демо-сервер с фейковыми игроками (npm run demo делает это сам)
SQUADPANEL_DEMO=0

# ----- Связь web <-> воркер -----
# Внутренний API воркера (наружу не открывать; доступ по токену из SQUADPANEL_SECRET)
WORKER_API_HOST=127.0.0.1
WORKER_API_PORT=3101
WORKER_URL=http://127.0.0.1:3101
# Адрес web для воркера. npm run dev ставит http://127.0.0.1:5173 сам, npm start — http://127.0.0.1:$PORT
# SQUADPANEL_WEB_URL=http://127.0.0.1:3000

# ----- Веб-панель (npm start / Docker) -----
PORT=3000
# HOST=127.0.0.1           # 0.0.0.0 — слушать на всех интерфейсах
# Адрес, по которому панель открывают в браузере. npm start по умолчанию ставит http://127.0.0.1:$PORT;
# при HOST=0.0.0.0, доступе по IP или за обратным прокси укажите свой (https://panel.example.com)
# ORIGIN=
# SQUADPANEL_PUBLIC_URL=

# ----- Discord (задел, вход через Discord пока не включён) -----
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# ----- docker compose -----
POSTGRES_USER=squadpanel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=squadpanel

STEAM_API_KEY=B3291DA8CCAD50C11F033D57EBF659F6